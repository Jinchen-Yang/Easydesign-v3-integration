{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "figure2-v3-candidate-metrics-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "method_id", "campaign_id", "candidate_id", "arm_id", "scaffold_id",
    "data_status", "generated", "native_evidence_complete", "native_pass",
    "competition_eligible", "filter_profile_id", "filter_profile_hash"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "method_id": {"enum": ["expert_curated_reference", "base_llm_tools", "generic_agent", "easydesign_v3_full", "native_interface_oracle"]},
    "campaign_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "arm_id": {"type": "string", "minLength": 1},
    "scaffold_id": {"type": "string", "minLength": 1},
    "data_status": {"enum": ["MEASURED", "DERIVED", "CONTROLLED_SIMULATION", "PLANNED", "UNAVAILABLE"]},
    "generated": {"type": "boolean"},
    "native_evidence_complete": {"type": "boolean"},
    "native_pass": {"type": ["boolean", "null"]},
    "competition_eligible": {"type": "boolean"},
    "filter_profile_id": {"type": "string", "minLength": 1},
    "filter_profile_hash": {"type": "string", "minLength": 1},
    "failure_reasons": {"type": "array", "items": {"type": "string"}},
    "bb_rmsd_design_angstrom": {"type": ["number", "null"], "minimum": 0},
    "target_aligned_rmsd_angstrom": {"type": ["number", "null"], "minimum": 0},
    "interface_pae": {"type": ["number", "null"], "minimum": 0},
    "iptm": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "ipsae": {"type": ["number", "null"]},
    "interface_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "delta_sasa_angstrom2": {"type": ["number", "null"], "minimum": 0},
    "hotspot_coverage_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "interface_hbond_count": {"type": ["integer", "null"], "minimum": 0},
    "interface_salt_bridge_count": {"type": ["integer", "null"], "minimum": 0},
    "clash_count": {"type": ["integer", "null"], "minimum": 0},
    "cdr3_interface_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "sequence_cluster_id": {"type": ["string", "null"]},
    "structure_cluster_id": {"type": ["string", "null"]},
    "global_rank": {"type": ["integer", "null"], "minimum": 1},
    "selected_top10": {"type": "boolean"},
    "afo_status": {"enum": ["available", "not-requested", "failed", "unavailable"]},
    "afo_rmsd_angstrom": {"type": ["number", "null"], "minimum": 0},
    "native_interface_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "native_interface_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
