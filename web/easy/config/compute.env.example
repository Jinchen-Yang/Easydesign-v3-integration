# Copy this file to .env.local at the repository root to enable read-only GPU monitoring.
# The alias must already work with: ssh -o BatchMode=yes -o StrictHostKeyChecking=yes Suzhou2 true
# Configure SSH identities/known_hosts outside this repository. Do not put keys here.
# Vite reads this on the server only; never prefix it with VITE_.
WORKBENCH_COMPUTE_SSH_HOST=Suzhou2
