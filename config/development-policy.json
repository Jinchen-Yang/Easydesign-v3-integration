{
  "schema_version": "0.1",
  "runtime_retention": {
    "automatic_deletion": false,
    "protected_paths": [
      ".venv",
      "examples/apoe-ui-demo",
      "workspace/projects",
      "workspace/runs",
      "workspace/archives",
      "runtime/state"
    ],
    "inventory_roots": [
      {
        "path": "runtime/tmp",
        "review_policy": "age",
        "minimum_age_days": 2,
        "budget_bytes": 5368709120
      },
      {
        "path": "runtime/cache",
        "review_policy": "manual",
        "minimum_age_days": null,
        "budget_bytes": 21474836480
      },
      {
        "path": "runtime/builds",
        "review_policy": "age",
        "minimum_age_days": 2,
        "budget_bytes": 1073741824
      },
      {
        "path": "runtime/validation",
        "review_policy": "age",
        "minimum_age_days": 7,
        "budget_bytes": 2147483648
      },
      {
        "path": "runtime/quarantine",
        "review_policy": "manual",
        "minimum_age_days": null,
        "budget_bytes": 5368709120
      }
    ]
  },
  "agent_guides": [
    {
      "path": "docs/agent/SCIENTIFIC_PIPELINE.md",
      "patterns": [
        "src/easydesign/core/**",
        "src/easydesign/stages/**",
        "src/easydesign/backends/**",
        "src/easydesign/filtering/**",
        "src/easydesign/orchestration/stage*.py",
        "docs/workflow/**"
      ]
    },
    {
      "path": "docs/agent/LOCAL_CLI_AND_VIEWER.md",
      "patterns": [
        "src/easydesign/cli.py",
        "src/easydesign/local_worker.py",
        "src/easydesign/orchestration/local_*.py",
        "src/easydesign/reporting/**",
        "web/target-viewer/**"
      ]
    },
    {
      "path": "docs/agent/RUNTIME_AND_DATA.md",
      "patterns": [
        "src/easydesign/workspace_context.py",
        "src/easydesign/orchestration/workspace*.py",
        "src/easydesign/orchestration/runtime*.py",
        "environments/**",
        "config/runtime-assets.yaml",
        "config/bootstrap-indexes.json",
        "scripts/bootstrap.py",
        "easydesign-workspace.yaml",
        "DATA_SAFETY.md"
      ]
    }
  ],
  "integration_patterns": [
    "src/easydesign/core/**",
    "src/easydesign/stages/**",
    "src/easydesign/backends/**",
    "src/easydesign/filtering/**",
    "src/easydesign/orchestration/stage*.py",
    "src/easydesign/orchestration/local_*.py",
    "src/easydesign/orchestration/runtime*.py",
    "src/easydesign/orchestration/setup_jobs.py",
    "src/easydesign/setup_worker.py",
    "src/easydesign/reporting/**",
    "web/target-viewer/**",
    "docs/workflow/**",
    "easydesign-workspace.yaml",
    "environments/**",
    "scripts/bootstrap.py",
    "config/bootstrap-indexes.json"
  ],
  "test_routes": [
    {
      "patterns": ["scripts/bootstrap.py", "config/bootstrap-indexes.json"],
      "tests": ["tests/unit/test_bootstrap.py", "tests/unit/test_uv_onboarding.py"]
    },
    {
      "patterns": ["scripts/dev.py", "config/development-policy.json"],
      "tests": ["tests/unit/test_dev_workflow.py"]
    },
    {
      "patterns": [
        "src/easydesign/cli.py",
        "src/easydesign/local_worker.py",
        "src/easydesign/orchestration/local_*.py"
      ],
      "tests": ["tests/unit/test_local_steps.py", "tests/unit/test_cli.py"]
    },
    {
      "patterns": ["src/easydesign/reporting/**", "web/target-viewer/**"],
      "tests": ["tests/unit/test_reporting_target_viewer.py"]
    },
    {
      "patterns": ["src/easydesign/orchestration/workspace*.py"],
      "tests": ["tests/unit/test_workspace_context.py", "tests/unit/orchestration/test_workspace.py"]
    },
    {
      "patterns": [
        "src/easydesign/orchestration/runtime*.py",
        "src/easydesign/orchestration/setup_jobs.py",
        "src/easydesign/setup_worker.py"
      ],
      "tests": [
        "tests/unit/orchestration/test_profile.py",
        "tests/unit/orchestration/test_runtime_setup.py",
        "tests/unit/orchestration/test_setup_jobs.py",
        "tests/unit/test_cli.py"
      ]
    }
  ]
}
