#!/usr/bin/env python3
"""Repository-local EasyDesign launcher.

This bootstrap intentionally uses only the Python standard library.  It never
changes shell profiles, proxies, Git configuration, base Conda or system files.
"""

from __future__ import annotations

import hashlib
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urlparse
from uuid import uuid4

ROOT = Path(__file__).resolve().parent
RUNTIME = ROOT / "runtime"
CORE_LOCK = ROOT / "environments" / "locks" / "easydesign-core-linux-64.lock.json"


def _runtime_dirs() -> None:
    for relative in (
        "envs",
        "models",
        "cache/conda",
        "cache/pip",
        "cache/xdg",
        "cache/corepack",
        "cache/playwright",
        "state",
        "logs",
        "tmp",
        "quarantine",
        "secrets",
        "home",
    ):
        (RUNTIME / relative).mkdir(parents=True, exist_ok=True)
    (ROOT / "projects").mkdir(parents=True, exist_ok=True)
    (ROOT / "runs").mkdir(parents=True, exist_ok=True)
    (ROOT / "archives").mkdir(parents=True, exist_ok=True)


def _git_config_path() -> Path:
    identity = hashlib.sha256(str(ROOT).encode("utf-8")).hexdigest()[:12]
    path = RUNTIME / "state" / "git" / f"workspace-{identity}-isolated-v1.config"
    path.parent.mkdir(parents=True, exist_ok=True)
    if not path.exists():
        lines = ("[safe]", f"\tdirectory = {ROOT}", "")
        with path.open("x", encoding="utf-8", newline="\n") as handle:
            handle.write("\n".join(lines))
    return path


def _validated_pip_index_url(value: str | None) -> str:
    selected = value or "https://pypi.org/simple"
    parsed = urlparse(selected)
    if parsed.scheme != "https" or not parsed.netloc:
        raise SystemExit("--pip-index-url 必须是完整 HTTPS URL")
    return selected


def _child_environment(*, pip_index_url: str | None = None) -> dict[str, str]:
    _runtime_dirs()
    environment = dict(os.environ)
    environment.update(
        {
            "HOME": str(RUNTIME / "home"),
            "TMPDIR": str(RUNTIME / "tmp"),
            "CONDA_PKGS_DIRS": str(RUNTIME / "cache" / "conda"),
            "PIP_CACHE_DIR": str(RUNTIME / "cache" / "pip"),
            "PIP_CONFIG_FILE": os.devnull,
            "PIP_INDEX_URL": _validated_pip_index_url(pip_index_url),
            "PIP_DISABLE_PIP_VERSION_CHECK": "1",
            "PIP_ROOT_USER_ACTION": "ignore",
            "PYTHONNOUSERSITE": "1",
            "XDG_CACHE_HOME": str(RUNTIME / "cache" / "xdg"),
            "XDG_DATA_HOME": str(RUNTIME / "state" / "xdg-data"),
            "XDG_STATE_HOME": str(RUNTIME / "state" / "xdg-state"),
            "COREPACK_HOME": str(RUNTIME / "cache" / "corepack"),
            "PLAYWRIGHT_BROWSERS_PATH": str(RUNTIME / "cache" / "playwright"),
            "NPM_CONFIG_CACHE": str(RUNTIME / "cache" / "npm"),
            "GIT_CONFIG_GLOBAL": str(_git_config_path()),
            "EASYDESIGN_WORKSPACE": str(ROOT),
        }
    )
    system_ca = Path("/etc/ssl/certs/ca-certificates.crt")
    if system_ca.is_file():
        environment["REQUESTS_CA_BUNDLE"] = str(system_ca)
        environment["PIP_CERT"] = str(system_ca)
        environment["SSL_CERT_FILE"] = str(system_ca)
        environment["NODE_EXTRA_CA_CERTS"] = str(system_ca)
    return environment


def _lock_sha() -> str:
    return hashlib.sha256(CORE_LOCK.read_bytes()).hexdigest()


def _core_prefix() -> Path:
    return RUNTIME / "envs" / f"easydesign-core-{_lock_sha()[:12]}"


def _core_python() -> Path:
    return _core_prefix() / "bin" / "python"


def _verified_core_lock_input(relative: str, expected_sha256: str) -> Path:
    path = (ROOT / relative).resolve(strict=True)
    try:
        path.relative_to(ROOT)
    except ValueError as error:
        raise SystemExit("Core lock 输入逃出 EasyDesign 仓库") from error
    actual = hashlib.sha256(path.read_bytes()).hexdigest()
    if actual != expected_sha256:
        raise SystemExit(
            f"Core lock 输入校验失败: {path}, "
            f"expected={expected_sha256}, actual={actual}"
        )
    return path


def _quarantine(path: Path, reason: str) -> Path:
    stamp = datetime.now(tz=timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    destination = RUNTIME / "quarantine" / f"{stamp}-bootstrap-{uuid4().hex[:10]}"
    destination.mkdir(parents=True, exist_ok=False)
    moved = destination / path.name
    shutil.move(str(path), str(moved))
    (destination / "reason.json").write_text(
        json.dumps({"reason": reason, "source": str(path.relative_to(ROOT))}, indent=2),
        encoding="utf-8",
    )
    return destination


def _find_conda(explicit_argument: str | None = None) -> str:
    explicit = explicit_argument or os.environ.get("EASYDESIGN_CONDA") or os.environ.get(
        "CONDA_EXE"
    )
    if explicit:
        candidate = Path(explicit).expanduser()
        if candidate.is_file():
            return str(candidate)
        raise SystemExit(f"EASYDESIGN_CONDA 指向不可用文件: {candidate}")
    candidates = (
        shutil.which("conda"),
        "/root/miniconda3/bin/conda",
        "/opt/conda/bin/conda",
    )
    for candidate in candidates:
        if candidate is not None and Path(candidate).is_file():
            return str(candidate)
    raise SystemExit(
        "未找到 Conda。请安装 Miniconda/Anaconda，或使用 "
        "./easydesign setup --conda /absolute/path/to/conda。"
    )


def _bootstrap_core(
    *,
    conda_executable: str | None = None,
    pip_index_url: str | None = None,
) -> None:
    python = _core_python()
    if python.is_file():
        return
    lock = json.loads(CORE_LOCK.read_text(encoding="utf-8"))
    if lock.get("schema_version") != "0.2":
        raise SystemExit("Core environment lock 必须使用 schema 0.2")
    conda_explicit = _verified_core_lock_input(
        lock["conda_explicit"],
        lock["conda_explicit_sha256"],
    )
    pip_requirements = None
    if lock.get("pip_requirements") is not None:
        pip_requirements = _verified_core_lock_input(
            lock["pip_requirements"],
            lock["pip_requirements_sha256"],
        )
    prefix = _core_prefix()
    if prefix.exists():
        _quarantine(prefix, "core 环境不完整，重新安装到相同锁身份的新路径前先隔离")
    command = [
        _find_conda(conda_executable),
        "create",
        "--yes",
        "--prefix",
        str(prefix),
        "--file",
        str(conda_explicit),
    ]
    print(f"正在建立仓库内 core 环境：{prefix}")
    completed = subprocess.run(
        command,
        cwd=ROOT,
        env=_child_environment(pip_index_url=pip_index_url),
        check=False,
    )
    if completed.returncode == 0 and pip_requirements is not None:
        completed = subprocess.run(
            [
                str(python),
                "-m",
                "pip",
                "install",
                "--no-deps",
                "--requirement",
                str(pip_requirements),
            ],
            cwd=ROOT,
            env=_child_environment(pip_index_url=pip_index_url),
            check=False,
        )
    if completed.returncode == 0 and lock.get("install_workspace_package", False):
        completed = subprocess.run(
            [
                str(python),
                "-m",
                "pip",
                "install",
                "--no-deps",
                "--no-build-isolation",
                "--editable",
                ".[dev,ui]",
            ],
            cwd=ROOT,
            env=_child_environment(pip_index_url=pip_index_url),
            check=False,
        )
    if completed.returncode != 0 or not python.is_file():
        if prefix.exists():
            quarantined = _quarantine(prefix, f"Conda 退出码 {completed.returncode}")
            print(f"未完成环境已隔离：{quarantined}", file=sys.stderr)
        raise SystemExit(completed.returncode or 4)


def _show_plan(arguments: list[str] | None = None) -> int:
    def human_bytes(value: int) -> str:
        amount = float(value)
        for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
            if amount < 1024 or unit == "TiB":
                return f"{amount:.1f} {unit}"
            amount /= 1024
        return f"{amount:.1f} TiB"

    arguments = [] if arguments is None else arguments
    lock_ids: tuple[str, ...] | None = None
    if "--minimal" in arguments:
        lock_ids = ("easydesign-core", "reporting-web")
    elif "--component" in arguments:
        index = arguments.index("--component")
        if index + 1 >= len(arguments):
            raise SystemExit("--component 必须提供组件 ID")
        component = arguments[index + 1]
        component_locks = {
            "core-ui": ("easydesign-core", "reporting-web"),
            "pymol-pse": ("pymol-pse",),
            "protenix-v2": ("protenix-v2",),
            "scannet-epitope": ("scannet-epitope",),
            "boltzgen": ("boltzgen",),
            "tnp": ("tnp",),
        }
        if component not in component_locks:
            raise SystemExit(f"未知 setup component: {component}")
        lock_ids = component_locks[component]
    locks = sorted((ROOT / "environments" / "locks").glob("*-linux-64.lock.json"))
    if lock_ids is not None:
        locks = [
            lock
            for lock in locks
            if json.loads(lock.read_text(encoding="utf-8"))["environment_id"]
            in lock_ids
        ]
    print("EasyDesign 完整安装计划")
    print(f"工作区：{ROOT}")
    print(f"所有环境：{RUNTIME / 'envs'}")
    print(f"所有模型：{RUNTIME / 'models'}")
    print(f"所有缓存：{RUNTIME / 'cache'}")
    print("不会修改：系统代理、shell profile、Git 全局配置、base Conda、/etc/environment")
    print("环境：")
    environment_bytes = 0
    for lock in locks:
        payload = json.loads(lock.read_text(encoding="utf-8"))
        digest = hashlib.sha256(lock.read_bytes()).hexdigest()[:12]
        size = int(payload["estimated_install_bytes"])
        environment_bytes += size
        print(
            f"  - {payload['environment_id']}: lock {digest}，"
            f"预计 {human_bytes(size)}"
        )
    usage = shutil.disk_usage(ROOT)
    conservative_peak = environment_bytes * 2
    print(f"环境安装与缓存峰值至少：{human_bytes(conservative_peak)}")
    print(f"工作区磁盘当前可用：{human_bytes(usage.free)}")
    print(
        "运行资产另需约 11.5 GiB；进入 Python 安装器后将按资产目录、"
        "现有文件和安全余量重新精确预检。"
    )
    print("许可敏感的运行资产将在下载前逐项请求明确确认。")
    return 0


def _translate_arguments(arguments: list[str]) -> list[str]:
    """Keep the documented repository shortcut aligned with the packaged CLI."""

    translated = list(arguments)
    if (
        translated[:1] == ["ui"]
        and translated[1:2] not in (["serve"], ["--help"], ["-h"])
    ):
        translated = ["ui", "serve", *translated[1:]]
    return translated


def main() -> int:
    arguments = sys.argv[1:]
    if (
        arguments[:1] == ["setup"]
        and "--plan" in arguments
        and not _core_python().is_file()
    ):
        return _show_plan(arguments)
    conda_executable = None
    if "--conda" in arguments:
        index = arguments.index("--conda")
        if index + 1 >= len(arguments):
            raise SystemExit("--conda 必须提供绝对 executable 路径")
        conda_executable = arguments[index + 1]
    resolved_conda = (
        _find_conda(conda_executable)
        if arguments[:1] == ["setup"]
        else conda_executable
    )
    pip_index_url = None
    if "--pip-index-url" in arguments:
        index = arguments.index("--pip-index-url")
        if index + 1 >= len(arguments):
            raise SystemExit("--pip-index-url 必须提供 HTTPS URL")
        pip_index_url = _validated_pip_index_url(arguments[index + 1])
    _bootstrap_core(
        conda_executable=resolved_conda,
        pip_index_url=pip_index_url,
    )
    translated = _translate_arguments(arguments)
    command = [_core_python(), "-m", "easydesign", *translated]
    child_environment = _child_environment(pip_index_url=pip_index_url)
    if resolved_conda is not None:
        child_environment["EASYDESIGN_CONDA"] = resolved_conda
    completed = subprocess.run(command, cwd=ROOT, env=child_environment, check=False)
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
