{
  "schema_version": "0.1",
  "agent_guides": [
    {
      "path": "docs/agent/SCIENTIFIC_PIPELINE.md",
      "patterns": [
        "src/easydesign/core/**",
        "src/easydesign/stages/**",
        "src/easydesign/backends/**",
        "src/easydesign/filtering/**",
        "src/easydesign/orchestration/stage*.py",
        "workflow/**"
      ]
    },
    {
      "path": "docs/agent/UI_AND_REPORTING.md",
      "patterns": [
        "src/easydesign/ui/**",
        "src/easydesign/reporting/**",
        "web/**"
      ]
    },
    {
      "path": "docs/agent/RUNTIME_AND_DATA.md",
      "patterns": [
        "src/easydesign/orchestration/workspace*.py",
        "src/easydesign/orchestration/runtime*.py",
        "src/easydesign/orchestration/setup*.py",
        "src/easydesign/orchestration/*registry*.py",
        "environments/**",
        "configs/runtime-assets.yaml",
        "easydesign-workspace.yaml",
        "DATA_SAFETY.md"
      ]
    },
    {
      "path": "docs/agent/RELEASE_AND_REMOTE.md",
      "patterns": [
        "pyproject.toml",
        "uv.lock",
        "Makefile",
        ".github/**",
        "scripts/check_built_wheel.py",
        "scripts/local_ui_release.py",
        "src/easydesign/managed_protocol.py",
        "src/easydesign/orchestration/remote*.py",
        "src/easydesign/backends/executors/ssh*.py"
      ]
    }
  ],
  "integration_patterns": [
    "src/easydesign/core/**",
    "src/easydesign/stages/**",
    "src/easydesign/backends/**",
    "src/easydesign/filtering/**",
    "src/easydesign/managed_protocol.py",
    "src/easydesign/orchestration/stage*.py",
    "src/easydesign/orchestration/remote*.py",
    "scripts/local_ui_release.py",
    "tests/unit/test_local_ui_release.py",
    "tests/fixtures/managed_protocol/**",
    "easydesign-workspace.yaml",
    "environments/**"
  ],
  "test_routes": [
    {
      "patterns": ["scripts/local_ui_release.py"],
      "tests": ["tests/unit/test_local_ui_release.py"]
    },
    {
      "patterns": ["scripts/dev.py", "configs/development-policy.json"],
      "tests": ["tests/unit/test_dev_workflow.py"]
    },
    {
      "patterns": ["src/easydesign/ui/**", "web/workbench/**"],
      "tests": ["tests/unit/ui"]
    },
    {
      "patterns": ["src/easydesign/cli.py", "easydesign", "scripts/**", "Makefile"],
      "tests": ["tests/unit/test_uv_onboarding.py", "tests/test_repository_structure.py"]
    },
    {
      "patterns": ["src/easydesign/orchestration/workspace*.py"],
      "tests": ["tests/unit/test_workspace_context.py", "tests/unit/orchestration/test_workspace.py"]
    }
  ]
}
