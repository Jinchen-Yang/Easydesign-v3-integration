{
  "name": "easydesign-easy-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 13190 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 13191 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.easy.config.ts",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:production": "node scripts/smoke-easy-production.mjs",
    "test:resources-live": "node scripts/smoke-resources-live.mjs",
    "test:easy": "vitest run tests/easy",
    "test:mascot:webkit": "node scripts/smoke-rabbit-webkit.mjs"
  },
  "dependencies": {
    "3dmol": "2.4.2",
    "@fontsource/inter": "5.1.1",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "prettier": "3.5.3",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  }
}
